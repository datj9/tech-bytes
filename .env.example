# --- LLM provider keys (pick the one matching your `llm.provider`) ---
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_API_KEY=...                  # for the local/OpenAI-compatible provider

# --- Provider selection (optional; config file is the default) ---
# LLM_PROVIDER=openai              # openai | anthropic | local
# LLM_MODEL=                       # blank = provider default
# LLM_BASE_URL=                    # for local: e.g. http://localhost:11434/v1

# --- Storage backend ---
# STORAGE=local                    # default; writes data/ in the repo
# STORAGE=s3                       # AWS path; also set DATA_BUCKET_NAME
# DATA_DIR=                        # override the local data dir (defaults to ../data)
# DATA_BUCKET_NAME=                # required only when STORAGE=s3

# --- Site build (Astro) ---
# PUBLIC_SITE_TITLE=Tech Bytes     # overrides config site.title
# PUBLIC_SITE_URL=                 # e.g. https://you.github.io/tech-bytes
# PUBLIC_BASE_PATH=/               # auto-detected from GITHUB_REPOSITORY if unset
# GITHUB_REPOSITORY=               # set automatically in Actions; helps base-path + contribute page

# --- GitHub API (optional; raises rate limit for trending/README fetches) ---
# GITHUB_TOKEN=ghp_...

# --- AWS path only (infra/ + deploy-aws.yml) ---
# AWS_PROFILE=
# AWS_REGION=
# OPENAI_KEY_SSM_PARAM=/tech-bytes/openai-api-key
# GITHUB_TOKEN_SSM_PARAM=/tech-bytes/github-token
# SUBSCRIBERS_SSM_PARAM=/tech-bytes/subscribers
# EMAIL_SENDER=digest@example.com
# SITE_URL=https://bytes.example.com
